<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cumba-oss-datatable-provider-parquet</artifactId>
    <packaging>jar</packaging>
    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-datatable-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <inceptionYear>2026</inceptionYear>
    <!--
        REQUIRED by Maven Central, and it must be declared HERE: <name> is one
        of the few POM elements Maven does NOT inherit from the parent, so a
        module without its own name publishes a nameless artifact and the whole
        Central bundle is rejected with "Project name is missing". This is the
        defect that cost cumba-oss-commons v0.0.1.
    -->
    <name>Cumba OSS Datatable :: Parquet Provider</name>
    <!--
        Declared explicitly rather than inherited: the parent carries
        child.project.url.inherit.append.path="false", which was measured to fix
        the <scm> URLs but NOT the project <url> under Maven 3.9.16 — the
        effective pom still read .../lib/<module>, a 404.
    -->
    <url>https://github.com/cumba-oss/cumba-oss-datatable</url>
    <description>
        Read-only Parquet provider for the Cumba OSS data-table SPI, built on
        the Carpet (com.jerolba) / parquet-mr libraries. No exporter and no
        jrdata-based R-metadata decoding are included (Cumba-native column labels are still read from the cumba:meta
        blob).
    </description>
    <organization>
        <name>P300</name>
    </organization>

    <properties>
        <mockito.agent>-javaagent:${org.mockito:mockito-core:jar}</mockito.agent>
    </properties>

    <dependencies>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable</artifactId>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-impl</artifactId>
        </dependency>

        <!--
            carpet-record drags in parquet-mr + a (carpet-pruned) hadoop-common tree. We
            deliberately do NOT exclude hadoop-mapreduce-client-core: ParquetFileReader.open()
            references org.apache.hadoop.mapreduce.lib.input.FileInputFormat at runtime, so the
            read path needs it. The transitive tree carpet-record ships is already lean
            (hadoop-common is reduced to hadoop-shaded-guava + commons-collections).
        -->
        <dependency>
            <groupId>com.jerolba</groupId>
            <artifactId>carpet-record</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- JSpecify nullability annotations (NullAway). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <reporting>
    </reporting>

</project>
